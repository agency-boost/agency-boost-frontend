# Only NEXT_PUBLIC_* reaches the browser. Anything secret must NOT carry that prefix —
# the build inlines these into client bundles and a leaked key is public permanently.
# Reference: ../docs/03-engineering/environments-and-configuration.md

# The API ORIGIN only — no path, no version.
#
# The API version belongs in code, not configuration. This client is written against a
# specific contract shape, so flipping a deployment to v2 without changing the code
# would break it: that is false flexibility, not a feature. Keeping the origin alone
# also lets the app call v1 and v2 side by side during a migration, which a
# version-bearing base URL cannot do without a second variable that can drift to a
# different host.
#
# See src/lib/api.ts and ../docs/02-specs/api/conventions.md.
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001

NEXT_PUBLIC_APP_ENV=development

# Optional, local development only (P19.6-T2, ADR-0217 §6): your dev bucket — the backend's GCS_BUCKET — so the
# app's Content-Security-Policy frames its HTML lessons. Unset, it frames nothing. Never set in Vercel: production
# and staging take their bucket from scripts/lib/deploy-env.mjs.
# NEXT_PUBLIC_STORAGE_BUCKET=
